    "block_type": 15,
    "parent_id": "TrMvddkf2oCpmTxf14hcvfLrn6f",
    "quote": {
      "elements": [
        {
          "text_run": {
            "content": "本文合并既有说明，截图来自不同界面版本，按钮位置以实际面板为准。部分原图含内部项目与任务信息，仅供内部使用；标注「脱敏」的图片也未重新审查，请勿直接外发。",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
