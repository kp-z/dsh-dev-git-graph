.tmp-profile-backup/

# DSH Desktop profile 升级 staging（含 pnpm store 与 node_modules，不入库）
.tmp-desktop-upgrade/

# 咒语书：数据库是投影 + 本地事件流，不入库
#   A 区丢了 rebuild 就回来；真正不可重建的 events 用 `node scripts/vault.mjs export` 搬走
packages/dsh-spellbook/data/
packages/dsh-spellbook/artifacts/


# 构建中途的临时目录（换名前）
packages/dsh-spellbook/.dist-staging-*/
packages/dsh-spellbook/.build.lock/

# 本机凭据与本地临时产物——绝不可入库
#   .npmrc 含 npm publish 用的 _authToken；漏进仓库等于泄露发布凭据
.npmrc
.backup-web-profile-package.json
*.tmp.html

# dsh-agent-world 运行时状态（宿主以仓库根为 cwd 时落在这里；是会话数据，不是源码）
.agent-teams/
.agent-world/
