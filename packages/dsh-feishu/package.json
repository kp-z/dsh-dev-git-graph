{
  "name": "dsh-feishu",
  "version": "0.9.60",
  "private": true,
  "type": "module",
  "description": "飞书同步插件：配置个人授权，定时把飞书任务与文档同步到本地，任务可直接开成 DSH 会话。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "panel.html",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "feishu_api.py"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "tasks",
    "docs",
    "sync"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "betterSidebar"
      ]
    }
  },
  "scripts": {
    "test:meta": "node test/meta.mjs",
    "test:client": "node test/client.mjs",
    "test:smoke": "DSH_HOME=/tmp/dsh-feishu-smoke node test/smoke.mjs",
    "test": "node test/meta.mjs && node test/client.mjs && DSH_HOME=/tmp/dsh-feishu-smoke node test/smoke.mjs"
  }
}