{
  "name": "dsh-agent-world",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：把多智能体协作搬进一座可视化 3D 小镇——每个真实 subagent 是一个会走动的角色，每件任务是一张可被拾取的工单，每次调度是一次空间上的移动与协作。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./domain": {
      "types": "./lib/domain/index.d.ts",
      "default": "./lib/domain/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "CREDITS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs && cp src/client.js lib/client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.json && node scripts/copy-web.mjs && node --test test/",
    "build:web": "node scripts/copy-web.mjs && cp src/client.js lib/client.js"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "multi-agent",
    "three.js",
    "3d",
    "simulation",
    "game"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
